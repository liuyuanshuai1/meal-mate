APP_NAME=MealMate API
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:15432/meal_mate
UPLOAD_DIR=static/uploads
PUBLIC_STATIC_URL=/static/uploads
TZ=Asia/Shanghai
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Add a one-time subscription template from the WeChat Mini Program console.
# Map each template field to creator, customer, summary, order_time, or meal_time.
# Example for "预约订单提醒": {"thing2":"customer","time3":"order_time","time4":"meal_time"}
WECHAT_DINNER_PLAN_TEMPLATE_ID=
WECHAT_DINNER_PLAN_TEMPLATE_FIELDS=
TOKEN_SECRET=replace-with-a-long-random-secret
TOKEN_TTL_DAYS=30
ADMIN_TOKEN=replace-with-a-long-random-admin-token
WECHAT_MOCK_LOGIN=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_EXPLORE_DAILY_LIMIT=20
