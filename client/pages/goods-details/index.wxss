.goods-name {
  padding: 30rpx 32rpx 24rpx;
  font-size: 38rpx;
  line-height: 52rpx;
  font-weight: 600;
  color: #352d25;
  border-bottom: 1rpx solid #eee0c0;
}
.goods-price {
  color: #9b8e79;
  margin: 18rpx 32rpx 0;
  padding-bottom: 20rpx;
  font-size: 25rpx;
  border-bottom: 1rpx solid #eee0c0;
}
.goods-desc {
  color: #786b58;
  font-size: 26rpx;
  line-height: 42rpx;
  padding: 24rpx 30rpx 0;
}
.goods-image {
  width:750rpx;
  display:block;
}
.size-label-box  .label{
  font-size:26rpx;
  color:#352d25;
  padding-left: 30rpx;
  padding: 30rpx 0 20rpx 30rpx;
}
.size-label-box .label-item-box{
  display: flex;
  margin-left: 30rpx;
  flex-direction: row;
  flex-wrap:wrap;
}
.size-label-box .label-item{
  font-size:26rpx;
  padding: 14rpx 20rpx;
  border: 1px solid #eee0c0;
  border-radius: 28rpx;
  color: #786b58;
  margin: 0 20rpx 20rpx 0;
}
.size-label-box .label-item.active{
  color: #e64340;
  border: 1px solid #e64340;
  background: #fff1ed;
}

.buy-num-box{
   display: flex;
   justify-content: space-between;
   padding: 26rpx 30rpx 40rpx 0;
   margin-left: 30rpx;
   /* border-top: 1px solid #eee0c0; */
   margin-top: 30rpx;
   align-items: center;
}
.num-label{
  font-size:26rpx;
}
.buy-num-box .num-box{
  display: flex;
}
.buy-num-box .num-box .num-jian,
.buy-num-box .num-box .num-input,
.buy-num-box .num-box .num-jia{
  width: 80rpx;
  height: 64rpx;
  line-height: 62rpx;
  text-align: center;
  border: 1px solid #eee0c0;
}
.buy-num-box .num-box .num-input{
  font-size: 28rpx;
}
.buy-num-box .num-box .num-input input{
  height: 100%;
}
.buy-num-box .num-box .hui{
  color: #aaa;
}
.btns {
  display: flex;
  padding: 0 24rpx 36rpx;
  gap: 16rpx;
}
.btns > view { flex: 1; min-width: 0; }
.btns button {
  width: 100%;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 29rpx;
}
.btns button::after { border: 0; }
.btns .weui-btn[type="primary"] {
  color: #b35e4d;
  background: #fff1ed;
}
.btns .weui-btn[type="warn"] {
  color: #fff;
  background: #e9564f;
}
.goIndex {
  position:fixed;
  right:20rpx;
  top:20rpx;
  width:80rpx;
  height:80rpx;
  border-radius:15px;
  background-color: #fff;
  text-align: center;
}
.goIndex-icon {
  width:50rpx;
  height:50rpx;
  margin-top: 15rpx;
}
.recipe {
  margin: 32rpx 24rpx;
  padding: 30rpx;
  background: #fffaf0;
  border: 1rpx solid #eee0c0;
  border-radius: 20rpx;
}
.recipe-title { color: #352d25; font-size: 31rpx; font-weight: 700; }
.recipe-time { color: #9b8e79; font-size: 23rpx; margin: 8rpx 0 18rpx; }
.recipe-ingredient { display: flex; justify-content: space-between; padding: 13rpx 0; color: #5d5143; font-size: 25rpx; border-bottom: 1rpx solid #eee6d8; }
.recipe-steps-heading { margin-top: 30rpx; margin-bottom: 20rpx; }
.recipe-step { display: flex; align-items: flex-start; margin-bottom: 22rpx; }
.recipe-step-number { width: 38rpx; height: 38rpx; line-height: 38rpx; text-align: center; border-radius: 50%; flex-shrink: 0; background: #e8b593; color: #fff; font-size: 23rpx; margin-right: 18rpx; }
.recipe-step-text { flex: 1; color: #51463b; font-size: 26rpx; line-height: 40rpx; }
.recipe-empty { margin: 24rpx 28rpx; padding: 20rpx 24rpx; border-radius: 14rpx; background: #fffaf0; color: #94836d; font-size: 24rpx; }
