.empty {
  margin: 24rpx 28rpx;
  padding: 180rpx 30rpx;
  border: 1rpx solid #eee5d4;
  border-radius: 22rpx;
  background: #fffaf0;
  color: #938774;
  font-size: 28rpx;
  text-align: center;
}
.record {
  margin: 20rpx 24rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid #eee5d4;
  border-radius: 20rpx;
  background: #fffaf0;
}
.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.record-time {
  color: #352d25;
  font-size: 28rpx;
  font-weight: 600;
}
.delete {
  color: #e64340;
  font-size: 26rpx;
}
.record-remark,
.record-total {
  margin-top: 14rpx;
  color: #817767;
  font-size: 24rpx;
}
.record-item {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  font-size: 25rpx;
}
.food-name {
  color: #352d25;
}
.food-meta {
  color: #938774;
}
.loading {
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
  text-align: center;
}
