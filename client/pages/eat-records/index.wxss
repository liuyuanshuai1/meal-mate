.empty {
  padding: 260rpx 30rpx 0;
  color: #999;
  font-size: 28rpx;
  text-align: center;
}
.record {
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #eee0c0;
}
.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.record-time {
  color: #1f1f1f;
  font-size: 30rpx;
  font-weight: 600;
}
.delete {
  color: #e64340;
  font-size: 26rpx;
}
.record-remark,
.record-total {
  margin-top: 14rpx;
  color: #777;
  font-size: 26rpx;
}
.record-item {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  font-size: 26rpx;
}
.food-name {
  color: #1f1f1f;
}
.food-meta {
  color: #777;
}
.loading {
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
  text-align: center;
}
