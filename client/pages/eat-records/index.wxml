<view class="page">
  <view class="page__bd">
    <view class="empty" wx:if="{{records.length === 0 && !loading}}">还没有一起吃过的记录</view>
    <view class="record" wx:for="{{records}}" wx:key="id">
      <view class="record-head">
        <view class="record-time">{{item.eaten_at}}</view>
        <view class="delete" bindtap="deleteRecord" data-id="{{item.id}}">删除</view>
      </view>
      <view class="record-remark" wx:if="{{item.remark}}">{{item.remark}}</view>
      <view class="record-total">本次获得 {{item.feeding_total}} 投喂值</view>
      <view class="record-items">
        <view class="record-item" wx:for="{{item.items}}" wx:for-item="food" wx:key="id">
          <view class="food-name">{{food.food_name || food.name}}</view>
          <view class="food-meta">x{{food.quantity || food.number}} {{food.spec || food.label}}</view>
        </view>
      </view>
    </view>
    <view class="loading" wx:if="{{loading}}">加载中...</view>
  </view>
</view>
