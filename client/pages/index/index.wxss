/* 轮播图 */
.swiper-container{
  width: 750rpx;
  position: relative;
}
.swiper_box {
  width: 750rpx;
  height:375rpx;
}
swiper-item image {
  width: 750rpx;
  height:375rpx;
}
.swiper-container .dots{
  position: absolute;
  left: 0;
  right: 0;
  bottom: 20rpx;
  display: flex;
  justify-content: center;
}
.swiper-container .dots .dot{
  margin: 0 8rpx;
  width: 14rpx;
  height: 14rpx;
  background: #fff;
  border-radius: 50%;
  transition: all .6s;
  opacity: .5;
}
.swiper-container .dots .dot.active{
  width: 14rpx;
  opacity: 1;
}
.recommend-title {
  text-align: left;
  font-size: 34rpx;
  line-height: 46rpx;
  font-weight: 600;
  color: #352d25;
  margin: 42rpx 28rpx 20rpx;
}
.ai-recommend {
  margin: 28rpx 24rpx 0;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #fffaf0;
  border: 1rpx solid #eee0c0;
  box-shadow: 0 8rpx 28rpx rgba(82, 57, 27, 0.05);
}
.ai-recommend-heading { color: #352d25; font-size: 34rpx; font-weight: 700; }
.ai-recommend-subtitle { color: #8d806d; font-size: 24rpx; margin-top: 8rpx; }
.ai-recommend-modes { display: flex; gap: 12rpx; margin-top: 24rpx; }
.ai-recommend-mode { flex: 1; text-align: center; padding: 13rpx 6rpx; border-radius: 16rpx; background: #f5ead7; color: #755f45; font-size: 24rpx; }
.ai-recommend-mode.is-active { background: #d45e4b; color: #fff; font-weight: 600; }
.ai-recommend-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 108rpx;
  margin-top: 26rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e9ddc9;
  border-radius: 16rpx;
  background: #fff;
  color: #352d25;
  font-size: 27rpx;
  line-height: 40rpx;
}
.ai-recommend-examples { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.ai-recommend-example {
  margin: 0 14rpx 12rpx 0;
  padding: 9rpx 18rpx;
  border-radius: 30rpx;
  background: #f4ead8;
  color: #725b3d;
  font-size: 22rpx;
}
.ai-recommend-button {
  margin-top: 12rpx;
  background: #d45e4b;
  color: #fff;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.ai-recommend-button::after { border: none; }
.ai-recommend-message { margin-top: 20rpx; color: #857965; font-size: 24rpx; }
.ai-recommend-results { margin-top: 24rpx; border-top: 1rpx solid #eee4d2; }
.ai-recommend-result { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f0e7d9; }
.ai-recommend-result:last-child { border-bottom: 0; padding-bottom: 0; }
.ai-recommend-image { width: 112rpx; height: 112rpx; border-radius: 14rpx; flex-shrink: 0; margin-right: 20rpx; }
.ai-recommend-result-body { flex: 1; min-width: 0; }
.ai-recommend-result-name { color: #352d25; font-size: 28rpx; font-weight: 600; }
.ai-recommend-result-meta { color: #a18e77; font-size: 21rpx; margin-top: 4rpx; }
.ai-recommend-result-reason { color: #6d6254; font-size: 23rpx; line-height: 34rpx; margin-top: 8rpx; }
.ai-recommend-arrow { color: #bc9c7b; font-size: 42rpx; margin-left: 12rpx; }
.ai-explore-results { margin-top: 24rpx; }
.ai-explore-note { color: #9a876c; font-size: 22rpx; margin-bottom: 14rpx; }
.ai-explore-card { background: #fff; border: 1rpx solid #eee0c9; border-radius: 18rpx; margin-bottom: 14rpx; overflow: hidden; }
.ai-explore-summary { display: flex; align-items: center; padding: 22rpx; }
.ai-explore-summary-body { flex: 1; min-width: 0; }
.ai-explore-name { color: #352d25; font-size: 29rpx; font-weight: 600; }
.ai-explore-meta { color: #a18e77; font-size: 21rpx; margin-top: 4rpx; }
.ai-explore-reason { color: #6d6254; font-size: 23rpx; line-height: 34rpx; margin-top: 8rpx; }
.ai-explore-detail { border-top: 1rpx solid #f0e7d9; padding: 20rpx 22rpx 24rpx; }
.ai-explore-section-title { color: #352d25; font-size: 25rpx; font-weight: 600; margin: 8rpx 0 14rpx; }
.ai-explore-ingredient { display: flex; justify-content: space-between; gap: 20rpx; padding: 8rpx 0; color: #625747; font-size: 23rpx; }
.ai-explore-missing { margin: 14rpx 0 24rpx; padding: 14rpx 18rpx; border-radius: 12rpx; background: #fff5e5; color: #8a5a25; font-size: 22rpx; line-height: 32rpx; }
.ai-explore-step { display: flex; gap: 16rpx; color: #625747; font-size: 23rpx; line-height: 36rpx; margin-bottom: 14rpx; }
.ai-explore-step-number { width: 32rpx; height: 32rpx; line-height: 32rpx; text-align: center; flex-shrink: 0; border-radius: 50%; background: #f4e2c8; color: #8a5a25; font-size: 20rpx; }
.goods-container{
  display: flex;
  justify-content: space-between;
  flex-wrap:wrap;
  box-sizing: border-box;
  padding: 0 24rpx;
}
.goods-box{
  width: 339rpx;
  min-height: 430rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: #fffaf0;
  border: 1rpx solid #eee5d4;
  box-sizing: border-box;
}
.goods-box .img-box{
  width: 100%;
  height: 310rpx;
  overflow: hidden;
}
.goods-box .img-box image{
   width: 100%;
   height: 310rpx;
}
.goods-box .goods-title{
  width: auto;
  text-overflow: ellipsis;
  white-space: nowrap;
  overflow: hidden;
  font-size: 29rpx;
  line-height: 40rpx;
  font-weight: 600;
  padding: 16rpx 18rpx 0;
  color: #352d25;
}
.goods-box .goods-price{
  width: auto;
  overflow: hidden;
  font-size: 23rpx;
  line-height: 34rpx;
  padding: 4rpx 18rpx 16rpx;
  color: #9b8e79;
}
.dinner-entry, .shared-entry {
  margin: 28rpx 24rpx 0;
  padding: 28rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fffaf0;
  border: 1rpx solid #eee0c0;
  border-radius: 20rpx;
}
.shared-entry { background: #fff2ef; border-color: #f1c4bd; }
.entry-title {
  font-size: 30rpx;
  color: #352d25;
  font-weight: 600;
}
.entry-desc {
  margin-top: 8rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 36rpx;
}
.entry-action {
  color: #e64340;
  font-size: 26rpx;
}
.empty-text {
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
  text-align: center;
}
.recent-wrap {
  padding-bottom: 40rpx;
}
.recent-list {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
}
.recent-item {
  margin: 0 16rpx 16rpx 0;
  padding: 10rpx 20rpx;
  color: #6e4f21;
  background: #fffaf0;
  border: 1rpx solid #eee0c0;
  border-radius: 28rpx;
  font-size: 24rpx;
}
.weui-cells {
  background:none;
  font-size: 26rpx;
  line-height: 26rpx;
}
.weui-cells image {
  margin-right: 5px;
  vertical-align: middle;
  width:30rpx;
  height: 30rpx;
}
