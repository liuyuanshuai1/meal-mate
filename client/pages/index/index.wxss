/* 轮播图 */
.swiper-container{
  width: 750rpx;
  position: relative;  
}
.swiper_box {
  width: 750rpx;
  height:375rpx;
}
swiper-item image {
  width: 750rpx;
  height:375rpx;
}
.swiper-container .dots{  
  position: absolute;  
  left: 0;  
  right: 0;  
  bottom: 20rpx;  
  display: flex;  
  justify-content: center;  
}  
.swiper-container .dots .dot{  
  margin: 0 8rpx;  
  width: 14rpx;  
  height: 14rpx;  
  background: #fff;  
  border-radius: 50%;  
  transition: all .6s;  
  opacity: .5;
}  
.swiper-container .dots .dot.active{  
  width: 14rpx;  
  opacity: 1;
}
.recommend-title {
  text-align: left;
  font-size: 34rpx;
  line-height: 46rpx;
  font-weight: 600;
  color: #352d25;
  margin: 42rpx 28rpx 20rpx;
}
.goods-container{
  display: flex;
  justify-content: space-between;
  flex-wrap:wrap;
  box-sizing: border-box;
  padding: 0 24rpx;
}
.goods-box{
  width: 339rpx;
  min-height: 430rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: #fffaf0;
  border: 1rpx solid #eee5d4;
  box-sizing: border-box;
}
.goods-box .img-box{
  width: 100%;
  height: 310rpx;
  overflow: hidden;
}
.goods-box .img-box image{
   width: 100%;
   height: 310rpx;
}
.goods-box .goods-title{
  width: auto;
  text-overflow: ellipsis;
  white-space: nowrap;
  overflow: hidden;
  font-size: 29rpx;
  line-height: 40rpx;
  font-weight: 600;
  padding: 16rpx 18rpx 0;
  color: #352d25;
}
.goods-box .goods-price{
  width: auto;
  overflow: hidden;
  font-size: 23rpx;
  line-height: 34rpx;
  padding: 4rpx 18rpx 16rpx;
  color: #9b8e79;
}
.dinner-entry, .shared-entry {
  margin: 28rpx 24rpx 0;
  padding: 28rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fffaf0;
  border: 1rpx solid #eee0c0;
  border-radius: 20rpx;
}
.shared-entry { background: #fff2ef; border-color: #f1c4bd; }
.entry-title {
  font-size: 30rpx;
  color: #352d25;
  font-weight: 600;
}
.entry-desc {
  margin-top: 8rpx;
  color: #777;
  font-size: 24rpx;
  line-height: 36rpx;
}
.entry-action {
  color: #e64340;
  font-size: 26rpx;
}
.empty-text {
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
  text-align: center;
}
.recent-wrap {
  padding-bottom: 40rpx;
}
.recent-list {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
}
.recent-item {
  margin: 0 16rpx 16rpx 0;
  padding: 10rpx 20rpx;
  color: #6e4f21;
  background: #fffaf0;
  border: 1rpx solid #eee0c0;
  border-radius: 28rpx;
  font-size: 24rpx;
}
.weui-cells {
  background:none;
  font-size: 26rpx;
  line-height: 26rpx;
}
.weui-cells image {
  margin-right: 5px;
  vertical-align: middle;
  width:30rpx; 
  height: 30rpx;
}
