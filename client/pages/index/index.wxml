<view class="page">
  <view class="page__bd">
    <swiper class="home-banner" wx:if="{{bannerList.length > 0}}" autoplay="{{bannerList.length > 1}}" circular="{{bannerList.length > 1}}" indicator-dots="{{bannerList.length > 1}}" interval="5000" indicator-color="rgba(255,255,255,0.55)" indicator-active-color="#ffffff">
      <swiper-item wx:for="{{bannerList}}" wx:key="id">
        <image class="home-banner-image" src="{{item.picUrl}}" mode="aspectFill" bindtap="tapBanner" data-item="{{item}}" />
      </swiper-item>
    </swiper>

    <view class="shared-entry" wx:if="{{sharedPlan}}" bindtap="goSharedPlan">
      <view>
        <view class="entry-title">{{sharedPlan.creator_name}} 发来一份菜单</view>
        <view class="entry-desc">共 {{sharedPlan.items.length}} 道，{{sharedPlan.feeding_total}} 投喂值</view>
      </view>
      <view class="entry-action">打开</view>
    </view>

    <view class="ai-recommend">
      <view class="ai-recommend-heading">今晚想吃什么？</view>
      <view class="ai-recommend-subtitle">说说冰箱里有什么，或想吃什么口味</view>
      <view class="ai-recommend-modes">
        <view class="ai-recommend-mode {{recommendationMode == 'menu' ? 'is-active' : ''}}" data-mode="menu" bindtap="switchRecommendationMode">菜单里推荐</view>
        <view class="ai-recommend-mode {{recommendationMode == 'explore' ? 'is-active' : ''}}" data-mode="explore" bindtap="switchRecommendationMode">探索新做法</view>
      </view>
      <textarea class="ai-recommend-input" placeholder="比如：有番茄和鸡蛋，想吃清淡的，半小时做好" maxlength="200" value="{{recommendationText}}" bindinput="onRecommendationInput" auto-height="true" />
      <button class="ai-recommend-button" bindtap="askRecommendation" loading="{{recommendationLoading}}" disabled="{{recommendationLoading}}">{{recommendationMode == 'explore' ? '探索新做法' : '帮我推荐'}}</button>
      <view class="ai-recommend-message" wx:if="{{recommendationMessage}}">{{recommendationMessage}}</view>
      <view class="ai-recommend-results" wx:if="{{recommendationItems.length > 0}}">
        <view class="ai-recommend-result" wx:for="{{recommendationItems}}" wx:key="food_id" data-id="{{item.food_id}}" bindtap="toDetailsTap">
          <image class="ai-recommend-image" src="{{item.image_url}}" mode="aspectFill" wx:if="{{item.image_url}}" />
          <view class="ai-recommend-result-body">
            <view class="ai-recommend-result-name">{{item.name}}</view>
            <view class="ai-recommend-result-meta">约 {{item.cook_minutes}} 分钟 · 查看做法</view>
            <view class="ai-recommend-result-reason">{{item.reason}}</view>
          </view>
          <view class="ai-recommend-arrow">›</view>
        </view>
      </view>
      <view class="ai-explore-results" wx:if="{{explorationItems.length > 0}}">
        <view class="ai-explore-note">AI 生成的做法 · 未加入菜单</view>
        <view class="ai-explore-card" wx:for="{{explorationItems}}" wx:for-item="recipe" wx:for-index="recipeIndex" wx:key="name">
          <view class="ai-explore-summary" data-index="{{recipeIndex}}" bindtap="toggleExplorationItem">
            <view class="ai-explore-summary-body">
              <view class="ai-explore-name">{{recipe.name}}</view>
              <view class="ai-explore-meta">约 {{recipe.cook_minutes}} 分钟 · {{recipe.servings}} 人份</view>
              <view class="ai-explore-reason">{{recipe.reason}}</view>
            </view>
            <view class="ai-recommend-arrow">{{expandedExplorationIndex == recipeIndex ? '⌃' : '›'}}</view>
          </view>
          <view class="ai-explore-detail" wx:if="{{expandedExplorationIndex == recipeIndex}}">
            <view class="ai-explore-section-title">需要的食材</view>
            <view class="ai-explore-ingredient" wx:for="{{recipe.ingredients}}" wx:for-item="ingredient" wx:key="name">
              <text>{{ingredient.name}}</text><text>{{ingredient.amount}}</text>
            </view>
            <view class="ai-explore-missing" wx:if="{{recipe.missing_text}}">还需准备：{{recipe.missing_text}}</view>
            <view class="ai-explore-section-title">做法</view>
            <view class="ai-explore-step" wx:for="{{recipe.steps}}" wx:for-item="step" wx:for-index="stepIndex" wx:key="*this">
              <view class="ai-explore-step-number">{{stepIndex + 1}}</view>
              <view>{{step}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
