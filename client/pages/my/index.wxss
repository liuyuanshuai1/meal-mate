.profile {
  margin: 24rpx 24rpx 18rpx;
  padding: 34rpx 30rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #eee5d4;
  border-radius: 22rpx;
  background: #fffaf0;
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: #f5e8d2;
}
.nickname {
  margin-left: 24rpx;
  color: #352d25;
  font-size: 31rpx;
  font-weight: 600;
}
.menu-list {
  margin: 0 24rpx 30rpx;
  padding: 0 26rpx;
  border: 1rpx solid #eee5d4;
  border-radius: 22rpx;
  background: #fffaf0;
}
.menu-item {
  min-height: 96rpx;
  line-height: 96rpx;
  padding: 0 34rpx 0 0;
  color: #4b4034;
  font-size: 27rpx;
  border-bottom: 1rpx solid #eee0c0;
  background: url(/images/arrow-right.png) no-repeat right center;
  background-size: 16rpx auto;
}
.menu-item:last-child { border-bottom: 0; }
