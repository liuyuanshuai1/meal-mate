.plan-page { padding: 32rpx 28rpx; box-sizing: border-box; }
.card, .empty { padding: 32rpx; border: 1rpx solid #eee5d4; border-radius: 24rpx; background: #fffaf0; }
.headline, .empty-title { margin-bottom: 20rpx; font-size: 34rpx; line-height: 46rpx; font-weight: 600; color: #352d25; }
.plan-time { margin-top: -12rpx; margin-bottom: 14rpx; color: #a65545; font-size: 25rpx; font-weight: 600; }
.plan-tabs { display: flex; gap: 12rpx; padding: 8rpx; margin: 4rpx 0 14rpx; border-radius: 16rpx; background: #f4ead8; }
.plan-tab { flex: 1; padding: 13rpx 0; border-radius: 12rpx; text-align: center; color: #806f5c; font-size: 25rpx; }
.plan-tab.is-active { background: #fff; color: #b55243; font-weight: 600; }
.shopping-title { margin: 28rpx 0 12rpx; color: #352d25; font-size: 27rpx; font-weight: 600; }
.shopping-item { display: flex; justify-content: space-between; gap: 20rpx; padding: 16rpx 0; border-bottom: 1rpx solid #eee5d4; color: #55493e; font-size: 25rpx; }
.shopping-item text:last-child { color: #8c7055; text-align: right; }
.shopping-note { margin-top: 22rpx; padding: 18rpx; border-radius: 12rpx; background: #fff2e0; color: #8a5a25; font-size: 23rpx; line-height: 34rpx; }
.shopping-hint, .shopping-empty { margin: 22rpx 0; color: #968975; font-size: 22rpx; line-height: 34rpx; }
.cook-note { margin: 0 0 20rpx; color: #9b705c; font-size: 24rpx; line-height: 36rpx; }
.hint { margin-bottom: 28rpx; color: #817767; font-size: 26rpx; line-height: 40rpx; }
.plan-food { border-bottom: 1rpx solid #eee0c0; }
.food { display: flex; align-items: center; padding: 18rpx 0; }
.food-image { width: 84rpx; height: 84rpx; margin-right: 20rpx; border-radius: 12rpx; background: #eee0c0; }
.food-body { flex: 1; min-width: 0; }
.food-top { display: flex; justify-content: space-between; gap: 12rpx; }
.food-name { color: #352d25; font-size: 27rpx; line-height: 38rpx; font-weight: 600; }
.food-count { color: #817767; }
.food-price { color: #9b8e79; font-size: 22rpx; }
.recipe-link { margin-top: 8rpx; color: #c65a49; font-size: 23rpx; }
.recipe-unavailable { margin-top: 8rpx; color: #a99b89; font-size: 22rpx; }
.plan-recipe { margin: 0 0 20rpx; padding: 20rpx 22rpx; border-radius: 16rpx; background: #fff; border: 1rpx solid #f0e3ce; }
.plan-recipe-heading { color: #352d25; font-size: 25rpx; font-weight: 600; }
.plan-recipe-time { margin-left: 12rpx; color: #9b8e79; font-size: 21rpx; font-weight: 400; }
.plan-ingredient { display: flex; justify-content: space-between; gap: 20rpx; padding: 9rpx 0; color: #625747; font-size: 23rpx; }
.plan-steps-heading { margin: 22rpx 0 14rpx; }
.plan-step { display: flex; gap: 14rpx; margin: 0 0 14rpx; color: #625747; font-size: 23rpx; line-height: 36rpx; }
.plan-step-number { flex-shrink: 0; width: 32rpx; height: 32rpx; border-radius: 50%; background: #f4e2c8; color: #8a5a25; text-align: center; line-height: 32rpx; font-size: 20rpx; }
.plan-step-text { flex: 1; min-width: 0; }
.total { padding: 26rpx 0; text-align: right; color: #352d25; font-size: 30rpx; font-weight: 600; }
.earned-total { margin: -14rpx 0 24rpx; text-align: right; color: #9b705c; font-size: 23rpx; line-height: 34rpx; }
.primary, .secondary { color: #fff; background: #e9564f; border-radius: 48rpx; font-size: 29rpx; }
.plain { margin-top: 18rpx; color: #817767; background: transparent; border: 1rpx solid #e7dcc4; border-radius: 48rpx; }
