.container{
    justify-content:initial;
}
.title-box{
    width: 100%;
    padding-top: 330rpx;
    text-align: center;
    font-size:28rpx;
    color:#938774;
    background: url(/images/icon-cart.png) no-repeat center 205rpx;
    background-size: 100rpx auto;
    margin-bottom: 50rpx;
}
.list-top{
    width: 100%;
    min-height: 96rpx;
    box-sizing: border-box;
    display: flex;
    justify-content:space-between;
    padding: 0 30rpx;
    font-size: 30rpx;
    align-items: center;
}
.list-top .label{
    color: #352d25;
    font-weight: 600;
}
.list-top .edit-btn{
    color: #9b8e79;
    padding: 16rpx 0 16rpx 20rpx;
    font-size: 25rpx;
}
.goodsList{
    width: 100%;
    padding-bottom: 100rpx;
}
.a-gooods{
    width: 100%;
    overflow: hidden;
}
.a-goods-conts{
    display: flex;
    justify-content:space-between;
    padding-left: 30rpx;
    width: 870rpx;
    box-sizing: border-box;
    transition: margin-left 0.2s ease-in-out;
    background: url(/images/gou.png) no-repeat 28rpx 56rpx;
    background-size: 40rpx auto;
}
.a-goods-conts.active{
    background: url(/images/gou-red.png) no-repeat 28rpx 56rpx;
    background-size: 40rpx auto;
}
.goods-info{
    border-bottom: 1px solid #eee0c0;
    display: flex;
    justify-content:flex-start;
    align-items: flex-start;
    padding: 24rpx 0 26rpx 70rpx;
    width: 720rpx;
    box-sizing: border-box;
}
.goods-info .img-box{
    width: 160rpx;
    height:160rpx;
    overflow: hidden;
    margin-right: 18rpx;
    border-radius: 14rpx;
    background-color: #eee0c0;
}
.goods-info .text-box{
    width: 450rpx;
    min-height: 160rpx;
    position: relative;
    display: flex;
    flex-direction: column;
}
.goods-info .text-box .goods-title{
    font-size: 29rpx;
    line-height: 40rpx;
    font-weight: 600;
    color:#352d25;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
    padding: 0 20rpx 0 0;
}
.goods-info .text-box .goods-label{
    font-size: 23rpx;
    color:#938774;
    line-height: 34rpx;
    margin: 4rpx 0 8rpx;
}
.goods-info .text-box .goods-price{
    font-size: 22rpx;
    line-height: 32rpx;
    color:#9b8e79;
}
.goods-info .text-box .buy-num{
    width: 164rpx;
    height: 48rpx;
    line-height: 48rpx;
    position: absolute;
    right: 14rpx;
    bottom: 0;
    display: flex;
    /*justify-content: space-between;*/
    font-size: 24rpx;
    text-align: center
}
.goods-info .text-box .buy-num .jian-btn{
    width: 48rpx;
    height: 100%;
    border-left: 1rpx solid #ccc;
    border-bottom: 1rpx solid #ccc;
    border-top: 1rpx solid #ccc;
    border-bottom-left-radius: 6rpx;
    border-top-left-radius: 6rpx;
}
.goods-info .text-box .buy-num .jian-btn.disabled{
  color: #ccc;
}
.goods-info .text-box .buy-num .jia-btn{
    width: 48rpx;
    height: 100%;
    border-right: 1rpx solid #ccc;
    border-bottom: 1rpx solid #ccc;
    border-top: 1rpx solid #ccc;
    border-bottom-right-radius: 6rpx;
    border-top-right-radius: 6rpx;
}
.goods-info .text-box .buy-num .jia-btn.disabled{
    background-color: #f5f5f9;
    border-right: 1rpx solid #eee;
    border-bottom: 1rpx solid #eee;
    border-top: 1rpx solid #eee;
    color: #ccc;
}
.goods-info .text-box .buy-num input{
    width: 68rpx;
    height: 48rpx;
    min-height: 48rpx;
    text-align: center;
    font-size: 24rpx;
    border: 1rpx solid #ccc;
}

.goods-info .img-box .img{
    width: 160rpx;
    height:160rpx;
}

.a-goods-conts .delete-btn{
    width: 120rpx;
    line-height: 220rpx;
    text-align: center;
    background:#e64340;
    font-size: 24rpx;
    color: #fff;
}
.jiesuan-box{
    display: flex;
    justify-content: space-between;
    width: 100%;
    height: 100rpx;
    position: fixed;
    bottom: 0;
    left: 0;
    border-bottom:1px solid #eee5d4;
    border-top:1px solid #eee5d4;
    background: #fffaf0;
    z-index: 999;
}
.jiesuan-box .to-pay-btn{
    width:240rpx;
    text-align: center;
    line-height: 100rpx;
    background-color: #e9564f;
    font-size:32rpx;
    color:#ffffff;
}
.jiesuan-box .to-pay-btn.no-select{
    background-color: #ccc;
}

.jiesuan-box  .left-price{
    display: flex;
    align-items: center;
    width: 510rpx;
    justify-content: flex-start;
    padding: 0 30rpx 0 0;
    font-size:25rpx;
    box-sizing: border-box;
    overflow: hidden;
}
.jiesuan-box .all-selected{
    padding-left: 90rpx;
    color:#5c5144;
    background: url(/images/gou.png) no-repeat 30rpx center;
    background-size: 40rpx auto;
}
.jiesuan-box .all-selected.active{
    background: url(/images/gou-red.png) no-repeat 30rpx center;
    background-size: 40rpx auto;
}
.jiesuan-box .cook-status{ flex: 1; min-width: 0; color: #9b705c; font-size: 21rpx; line-height: 30rpx; text-align: center; }
.cook-select-row { display: flex; flex-wrap: wrap; align-items: center; margin-top: 12rpx; padding-bottom: 54rpx; }
.cook-label { width: 100%; margin-bottom: 8rpx; color: #847763; font-size: 22rpx; line-height: 30rpx; }
.cook-chip { margin: 0 10rpx 0 0; padding: 7rpx 16rpx; border: 1rpx solid #e7dcc4; border-radius: 28rpx; color: #786b58; font-size: 22rpx; line-height: 30rpx; }
.cook-chip.active { border-color: #e64340; color: #c84c45; background: #fff1ed; }
